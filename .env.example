# Copy to .env and fill in. Never commit .env.
#
# The database and role are created by the platform's `bin/provision art`,
# which writes POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB into .env
# directly - the password is generated on the box and is never printed.

APP_ENV=development

# In production these are the per-app role provision created, and the host is
# the shared PostgreSQL's network alias.
POSTGRES_USER=art
POSTGRES_PASSWORD=
POSTGRES_DB=art
DATABASE_URL=postgresql://art:@db:5432/art

# Compose derives its project name from the directory otherwise, which mounts a
# different volume. Pin it.
COMPOSE_PROJECT_NAME=art
